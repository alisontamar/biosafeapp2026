{
  "expo": {
    "name": "BioSafe",
    "slug": "biosafe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "biosafe",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biosafe.app"
    },
    "android": {
      "package": "com.biosafe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "BioSafe necesita acceso a tus fotos para subir el carnet de vacunación.",
          "cameraPermission": "BioSafe necesita acceso a la cámara para fotografiar el carnet de vacunación."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BioSafe necesita la cámara para escanear códigos QR de pacientes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BioSafe usa tu ubicación para darte recomendaciones de salud según el clima de tu ciudad."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74c5fa6d-5d6c-4f36-aed2-216afda9ea6b"
      }
    },
    "owner": "alisontamara"
  }
}
